# Copy to .env and fill in. Never commit .env.

# LLM (OpenAI-compatible). Default: OpenRouter.
ECHO_LLM_BASE_URL=https://openrouter.ai/api/v1
ECHO_LLM_MODEL=anthropic/claude-haiku-4.5
# Prefer ECHO_LLM_API_KEY; falls back to OPENROUTER_API_KEY then ANTHROPIC_API_KEY
ECHO_LLM_API_KEY=

# STT: faster_whisper (default) | parakeet
ECHO_STT=faster_whisper
ECHO_STT_MODEL=large-v3-turbo
ECHO_STT_COMPUTE=float16
# Parakeet backend (ECHO_STT=parakeet). Needs transformers>=5 + librosa.
# Runs on CUDA/float16 via native transformers ParakeetForTDT (no NeMo).
ECHO_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# TTS: fish (default, S2-Pro) | kokoro (light local fallback)
# fish resolution: local checkpoints → ECHO_FISH_URL API → FISH_API_KEY cloud
ECHO_TTS=fish
ECHO_TTS_FALLBACK_KOKORO=1
# Kokoro single warm voice (used when backend=kokoro or as fallback)
ECHO_TTS_VOICE=af_heart
ECHO_TTS_LANG=a
# Fish local (needs ~24GB VRAM — not feasible on RTX 5050 8GB alongside STT)
# hf download fishaudio/s2-pro --local-dir checkpoints/s2-pro
ECHO_FISH_CHECKPOINT_DIR=checkpoints/s2-pro
# Optional fish-speech HTTP server (separate process/machine)
# ECHO_FISH_URL=http://127.0.0.1:8080
# Hosted Fish Audio API (https://fish.audio/app/api-keys)
# ECHO_FISH_API_KEY=
# FISH_API_KEY=
ECHO_FISH_CLOUD_MODEL=s2-pro
# Fixed single reference voice id (local folder name or cloud voice id); empty = default timbre
# ECHO_FISH_REFERENCE_ID=

# Runtime
ECHO_DEVICE=cuda
ECHO_WS_HOST=0.0.0.0
ECHO_WS_PORT=8787
ECHO_SAMPLE_RATE_IN=16000
ECHO_SYSTEM_PROMPT=You are Echo, a concise helpful voice assistant. Keep replies short (1-3 sentences) unless asked for detail. No markdown, no bullet lists — speak naturally.
