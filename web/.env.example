# Echo WebSocket URL (FastAPI /ws/converse)
# Local default:
NEXT_PUBLIC_ECHO_WS_URL=ws://127.0.0.1:8787/ws/converse

# LAN example (replace with your host IP):
# NEXT_PUBLIC_ECHO_WS_URL=ws://192.168.1.10:8787/ws/converse

# Production / tunnel (WSS):
# NEXT_PUBLIC_ECHO_WS_URL=wss://echo.example.com/ws/converse
